#!/bin/sh
# 스테이징한 이번 버전 릴리스 노트를 검사한다.
#
# 왜 있나: 발행 직전 한 번만 재면 늦다. 노트가 여러 커밋에 걸쳐 고쳐지는 동안
# 한 번도 안 도는 버전이 실제로 있었다. 규칙과 까닭은
# docs/dev/release-notes-rules.md의 「언제 도나」가 갖는다.
#
# **여기서 가르지 않는다.** `--current-only`가 준 파일 중 이번 버전 노트만 골라
# 검사하고, 없으면 건너뛰며 0으로 끝난다. 나가 있는 버전은 소급해 고치지 않으므로
# 옛 버전만 고치는 커밋은 그 자리에서 통과한다. 훅이 같은 판정을 또 하면 두 곳이
# 갈리고, 갈린 것을 아무도 안 본다.
#
# **이것은 최종 방어선이 아니다.** 훅이 안 걸린 클론에서도 `tools/pack/release.py`의
# 게이트가 같은 검사를 부르므로 어긴 노트는 발행에서 막힌다. 훅은 그것을 더 이른
# 시점에 알려 주는 자리다.
#
# `uv run`을 쓰는 까닭: 이 훅은 이 저장소에서만 돌고 cwd가 저장소 루트라, 이
# 저장소의 pyproject를 쓰는 것이 맞다. 저장소의 다른 도구가 전부 그렇게 불린다.
# (`~/.claude` 훅이 `uv run`을 피하는 것은 그쪽이 아무 저장소에서나 돌기 때문이다.)

exec uv run python tools/notes-check/notes_check.py --current-only \
	$(git diff --cached --name-only --diff-filter=ACM -- docs/release-notes)
