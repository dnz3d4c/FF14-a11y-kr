<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>koterms</AssemblyName>
    <RootNamespace>koterms</RootNamespace>
    <!-- 한국어를 그대로 찍어야 하므로 글로벌라이제이션을 죽이지 않는다.
         업스트림 cmdump는 InvariantGlobalization=true인데, 그건 영어만 뽑기
         때문이다. -->
  </PropertyGroup>
  <ItemGroup>
    <!-- Dalamud가 들고 있는 것을 그대로 쓴다. 재배포하지 않는다 -
         업스트림 tools/charamake-dump/cmdump.csproj와 같은 방식이다. -->
    <Reference Include="Lumina">
      <HintPath>$(DALAMUD_HOME)/Lumina.dll</HintPath>
    </Reference>
    <Reference Include="Lumina.Excel">
      <HintPath>$(DALAMUD_HOME)/Lumina.Excel.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
